<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.solgarlic"
       name="SolGarlic Repository"
       version="1.0.0"
       provider-name="solgarlic">
    <extension point="xbmc.addon.repository" name="SolGarlic Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/solgarlic/repository.solgarlic/main/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/solgarlic/repository.solgarlic/main/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/solgarlic/repository.solgarlic/main/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">SolGarlic's personal Kodi addon repository</summary>
        <description lang="en">Personal repository for updated forks of a4kSubtitles and jacktook while upstream PRs are pending.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>